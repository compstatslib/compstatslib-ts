{
  "name": "compstatslib",
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive visualizations for computational statistics concepts, in the browser.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --format esm --sourcemap=linked && bunx tsc -p tsconfig.build.json",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "dev": "bun run demo/server.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@types/bun": "^1.3.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0"
  }
}
